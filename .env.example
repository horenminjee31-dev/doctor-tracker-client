# Copy to .env.local for local development.
# Next.js rewrites /api/backend/* to this target so the session cookie stays first-party.
API_PROXY_TARGET=http://127.0.0.1:5000

# Production (Vercel): point this at the deployed API origin, e.g.
# API_PROXY_TARGET=https://doctor-tracker-api.onrender.com
# Rewrites are compiled at build time — redeploy after changing it.

# Optional: only set this for a cross-origin deployment where the browser calls
# the API directly. The httpOnly session cookie then becomes third-party, so the
# cookie/route-guard configuration must change as well. Leave unset for the
# supported proxy topology.
# NEXT_PUBLIC_API_URL=
